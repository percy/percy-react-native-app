{
  "name": "percy-storybook-react-native-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Percy SDK for visual testing of React Native Storybook components on real devices via Appium.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.39.4"
  }
}

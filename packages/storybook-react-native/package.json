{
  "name": "@percy/storybook-react-native",
  "version": "0.2.0-alpha.0",
  "description": "Percy SDK for visual testing of React Native Storybook components via Appium. Supports local emulator/simulator (CLI mode) and BrowserStack App Automate (library mode).",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./cli": "./src/index.js"
  },
  "files": [
    "index.js",
    "percy",
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . || true"
  },
  "@percy/cli": {
    "commands": [
      "./src/commands/storybook-rn.js"
    ]
  },
  "dependencies": {
    "@percy/cli-command": "^1.30.0",
    "@percy/config": "^1.30.0",
    "@percy/logger": "^1.30.0",
    "@percy/sdk-utils": "^1.30.0",
    "webdriverio": "^9.0.0",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@percy/appium-app": "~2.1.0"
  },
  "peerDependenciesMeta": {
    "@percy/appium-app": {
      "optional": true
    }
  },
  "devDependencies": {
    "@percy/appium-app": "~2.1.0",
    "@percy/cli": "^1.31.12",
    "appium": "^2.19.0",
    "appium-xcuitest-driver": "^8.4.3",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "percy",
    "storybook",
    "react-native",
    "visual-testing",
    "appium",
    "app-automate",
    "browserstack"
  ],
  "license": "MIT"
}

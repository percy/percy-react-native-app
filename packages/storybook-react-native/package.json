{
  "name": "@percy/storybook-react-native",
  "version": "0.2.0",
  "description": "Percy SDK for visual testing of React Native Storybook components via Appium. Supports local emulator/simulator (CLI mode) and BrowserStack App Automate (library mode).",
  "keywords": [
    "percy",
    "storybook",
    "react-native",
    "visual-testing",
    "appium",
    "app-automate",
    "browserstack"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/percy/percy-react-native-app.git",
    "directory": "packages/storybook-react-native"
  },
  "bugs": {
    "url": "https://github.com/percy/percy-react-native-app/issues"
  },
  "homepage": "https://github.com/percy/percy-react-native-app/tree/main/packages/storybook-react-native#readme",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./cli": "./src/index.js"
  },
  "files": [
    "index.js",
    "percy",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "prepublishOnly": "npm run lint && npm test"
  },
  "@percy/cli": {
    "commands": [
      "./src/commands/storybook-rn.js"
    ]
  },
  "dependencies": {
    "@babel/parser": "^7.29.3",
    "@percy/cli-command": "^1.30.0",
    "@percy/config": "^1.30.0",
    "@percy/logger": "^1.30.0",
    "@percy/sdk-utils": "^1.30.0",
    "adm-zip": "^0.5.17",
    "webdriverio": "^9.0.0",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@percy/appium-app": "~2.1.0"
  },
  "peerDependenciesMeta": {
    "@percy/appium-app": {
      "optional": true
    }
  },
  "devDependencies": {
    "@percy/appium-app": "~2.1.0",
    "@percy/cli": "^1.31.12",
    "@vitest/coverage-v8": "^2.0.0",
    "appium": "^2.19.0",
    "appium-xcuitest-driver": "^8.4.3",
    "eslint": "^9.10.0",
    "vitest": "^2.0.0"
  },
  "optionalDependencies": {
    "@esbuild/darwin-arm64": "0.21.5",
    "@esbuild/darwin-x64": "0.21.5",
    "@esbuild/linux-arm64": "0.21.5",
    "@esbuild/linux-x64": "0.21.5",
    "@esbuild/win32-x64": "0.21.5",
    "@rollup/rollup-darwin-arm64": "4.61.1",
    "@rollup/rollup-darwin-x64": "4.61.1",
    "@rollup/rollup-linux-arm64-gnu": "4.61.1",
    "@rollup/rollup-linux-x64-gnu": "4.61.1",
    "@rollup/rollup-win32-x64-msvc": "4.61.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
